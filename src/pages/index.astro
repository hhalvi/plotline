---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import LogoStrip from '../components/LogoStrip.astro';
import Engagement from '../components/Engagement.astro';
import ExperienceLibrary from '../components/ExperienceLibrary.astro';
import UseCases from '../components/UseCases.astro';
import Enterprise from '../components/Enterprise.astro';
---

<Layout
  title="Plotline — Act on every customer signal, at the exact moment it matters"
  description="An AI marketer that delivers the next best action for every customer. Email. Push. In-app. SMS. Or nothing at all."
>
  <Nav />
  <main>
    <Hero />
    <LogoStrip />
    <Engagement />
    <ExperienceLibrary />
    <UseCases />
    <Enterprise />
  </main>
</Layout>
