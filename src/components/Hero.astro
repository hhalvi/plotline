---
// Figma node 137:1358 ("hero")
import { Picture, Image } from 'astro:assets';
import heroArt from '../assets/figma/hero-art.png';
import heroPortrait from '../assets/figma/hero-portrait.png';
import heroMask from '../assets/figma/hero-mask.svg';
---

<section class="hero">
  <div class="shell">
    <div class="hero-content">
      <h1 class="h-display reveal">
        Act on every customer signal,<br />at the exact moment it matters.
      </h1>
      <p class="hero-sub reveal" style="--d:.12s">
        An AI marketer that delivers the next best action for every customer.<br />
        Email. Push. In-app. SMS. Or nothing at all.
      </p>
      <div class="hero-ctas reveal" style="--d:.22s">
        <a href="#contact" class="btn btn-primary">Contact Us</a>
        <a href="#library" class="btn btn-ghost">See it in Action</a>
      </div>
    </div>

    <div class="hero-media reveal" style="--d:.3s">
      <Image
        src={heroPortrait}
        alt="A customer reading messages on their phone"
        class="hero-portrait"
        width={696}
        densities={[1, 2]}
        loading="eager"
        fetchpriority="high"
      />
      <div class="hero-art" style={`--mask: url(${JSON.stringify(heroMask.src)})`}>
        <Picture
          src={heroArt}
          alt="Illustrated building facade with people living their daily moments in every window"
          widths={[860, 1300, 2300]}
          sizes="(max-width: 900px) 100vw, 80vw"
          formats={['avif']}
          fallbackFormat="webp"
          loading="eager"
          fetchpriority="high"
        />
        <div class="hero-art-tint" aria-hidden="true"></div>
        <div class="hero-glass" aria-hidden="true"></div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: 40px;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    gap: 24px;
    align-items: flex-start;
  }

  .hero-sub {
    font-size: 18px;
    line-height: 26px;
    max-width: 584px;
  }

  .hero-ctas {
    display: flex;
    gap: 16px;
  }

  /* media collage — 1350x505 in the 1440 design */
  .hero-media {
    position: relative;
    margin-top: 48px;
    aspect-ratio: 1350 / 505;
  }

  .hero-portrait {
    position: absolute;
    inset: 0 auto 0 0;
    width: 25.78%; /* 348/1350 */
    height: 100%;
    object-fit: contain;
    z-index: 2;
  }

  .hero-art {
    position: absolute;
    inset: 0 0 0 15.26%; /* 206/1350 */
    mask-image: var(--mask);
    -webkit-mask-image: var(--mask);
    mask-size: 100% 100%;
    -webkit-mask-size: 100% 100%;
    mask-repeat: no-repeat;
    -webkit-mask-repeat: no-repeat;
  }

  .hero-art :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 12px;
  }

  .hero-art-tint {
    position: absolute;
    inset: 0;
    background: linear-gradient(-42deg, rgba(83, 58, 254, 0.55) -18%, rgba(83, 58, 254, 0) 38%);
  }

  .hero-glass {
    position: absolute;
    top: 50%;
    left: 25.35%; /* (496-206)/1144 */
    width: 63.8%; /* 730/1144 */
    aspect-ratio: 730 / 400;
    transform: translateY(-50%);
    border-radius: 12px;
    border: 2px solid rgba(255, 255, 255, 0.6);
    background: rgba(255, 255, 255, 0.21);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    animation: glass-drift 9s ease-in-out infinite alternate;
  }

  @keyframes glass-drift {
    from {
      transform: translateY(calc(-50% - 6px));
    }
    to {
      transform: translateY(calc(-50% + 6px));
    }
  }

  @media (max-width: 720px) {
    .hero-content :global(br) {
      display: none;
    }
    .hero-media {
      aspect-ratio: auto;
      display: grid;
      gap: 16px;
    }
    .hero-portrait {
      display: none;
    }
    .hero-art {
      position: relative;
      inset: auto;
      mask-image: none;
      -webkit-mask-image: none;
      border-radius: 12px;
      overflow: hidden;
    }
    .hero-glass {
      left: 10%;
      width: 80%;
    }
  }
</style>
